<Window x:Class="Snapdex.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="snapdex"
        Height="720"
        Width="1280"
        MinHeight="560"
        MinWidth="900"
        Loaded="Window_OnLoaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Refresh"
                        Padding="14,8"
                        Margin="8,0,0,0"
                        Click="RefreshButton_OnClick" />
                <Button Content="Index Pictures"
                        Padding="14,8"
                        Margin="8,0,0,0"
                        Click="IndexFolderButton_OnClick" />
            </StackPanel>

            <TextBox x:Name="QueryTextBox"
                     VerticalAlignment="Center"
                     FontSize="14"
                     Padding="10,8"
                     TextChanged="QueryTextBox_OnTextChanged"
                     ToolTip="Search: camera:Canon lens:Sigma iso:>800 date:2025-01-01..2025-01-31" />
        </DockPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="0,0,0,12"
                   Foreground="#374151"
                   Text="No index yet. Click 'Index Pictures' to get started." />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="ResultsGrid"
                      Grid.Column="0"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      SelectionMode="Single"
                      CanUserResizeRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      MouseDoubleClick="ResultsGrid_OnMouseDoubleClick"
                      RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Preview" Width="110" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" ClipToBounds="True" Width="96" Height="72" Background="#E5E7EB">
                                    <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Filename" Binding="{Binding Filename}" Width="2*" />
                    <DataGridTextColumn Header="Captured" Binding="{Binding CaptureDateText}" Width="1.2*" />
                    <DataGridTextColumn Header="Camera" Binding="{Binding CameraText}" Width="1.5*" />
                    <DataGridTextColumn Header="Lens" Binding="{Binding LensText}" Width="1.3*" />
                    <DataGridTextColumn Header="ISO" Binding="{Binding IsoText}" Width="0.8*" />
                    <DataGridTextColumn Header="f" Binding="{Binding ApertureText}" Width="0.8*" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="14"
                    BorderThickness="1"
                    BorderBrush="#E5E7EB"
                    CornerRadius="6"
                    Background="#FAFAFA">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <TextBlock Text="File" FontWeight="SemiBold" />
                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,10"
                                   Text="{Binding ElementName=ResultsGrid, Path=SelectedItem.DisplayPath, TargetNullValue=Select a result...}" />

                        <TextBlock Text="Captured" FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,8"
                                   Text="{Binding ElementName=ResultsGrid, Path=SelectedItem.CaptureDateText, TargetNullValue=—}" />

                        <TextBlock Text="Camera" FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,8"
                                   Text="{Binding ElementName=ResultsGrid, Path=SelectedItem.CameraText, TargetNullValue=—}" />

                        <TextBlock Text="Lens" FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,8"
                                   Text="{Binding ElementName=ResultsGrid, Path=SelectedItem.LensText, TargetNullValue=—}" />

                        <TextBlock Text="Exposure" FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,2"
                                   Text="{Binding ElementName=ResultsGrid, Path=SelectedItem.IsoDisplayText, TargetNullValue=—}" />
                        <TextBlock Margin="0,0,0,2"
                                   Text="{Binding ElementName=ResultsGrid, Path=SelectedItem.ApertureText, TargetNullValue=—}" />
                        <TextBlock Margin="0,0,0,8"
                                   Text="{Binding ElementName=ResultsGrid, Path=SelectedItem.ShutterText, TargetNullValue=—}" />

                        <TextBlock Text="Focal length" FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,8"
                                   Text="{Binding ElementName=ResultsGrid, Path=SelectedItem.FocalLengthText, TargetNullValue=—}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
